    "enabled": true,
    "prompt": "Sempre responda em pt-BR e cite o arquivo tocado.",
    "hooks": [
      {
        "event": "tool_call",
        "arg": "python tests/hook_block.py",
        "desc": "bloqueia bash"
      }
